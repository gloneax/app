---
/********************************************************************* 
Author: Sukanta Manna  
Purpose: This is home page to the App. Here, we display statistics of 
         last few years across supported languages.
**********************************************************************/
import Layout from "@/layouts/main.astro";
import EarthquakeStatsChart from "../components/EarthquakeStatsChart";
import VolcanoStatsSummary from '../components/VolcanoStatsSummary';
import StormInsightsCard from '../components/StormInsightsCard';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // Matches "/"
    { params: { lang: 'bn' } },      // Matches "/bn"
    { params: { lang: 'es' } },      // Matches "/es"
    { params: { lang: 'fr' } },      // Matches "/fr"
    { params: { lang: 'hi' } },      // Matches "/hi"
    { params: { lang: 'ja' } },      // Matches "/ja"
    { params: { lang: 'ru' } },      // Matches "/ru"
    { params: { lang: 'zh' } },      // Matches "/zh"
  ];
}

const { lang = 'en' } = Astro.params;
---

<Layout>
  <div class="w-full h-full min-h-screen overflow-y-auto p-4 sm:p-6 flex flex-col gap-6">
    {/* Figure 1: 10-Year Earthquake Chart */}
    <div class="w-full shrink-0">
      <EarthquakeStatsChart client:only="react" />
    </div>

    {/* Figure 2: Volcanic Activity Summary directly below */}
    <div class="w-full shrink-0 pb-12">
      <VolcanoStatsSummary client:only="react" />
    </div>

    {/* Figure 3: Storm Insights */}
    <div class="w-full shrink-0 pb-12">
      <StormInsightsCard client:only="react" />
    </div>
  </div>
</Layout>