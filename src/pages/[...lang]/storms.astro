import GlobalStormMap from "../../components/GlobalStormMap"
import Layout from "../../layouts/main.astro"

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'bn' } },
    { params: { lang: 'es' } },  
    { params: { lang: 'fr' } }, 
    { params: { lang: 'hi' } },
    { params: { lang: 'ja' } }, 
    { params: { lang: 'ru' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
---

<Layout>
  <div class="h-full w-full flex">
    <GlobalStormMap client:only/>
  </div>
</Layout>